<!--
  Regenerates the checked-in CoreCLR WebAssembly call helpers under this directory.

  Driven by generate-coreclr-helpers.sh / .cmd, which only parse arguments and hand the work
  here, so the module list, the crossgen2 lookup and the scan paths are expressed once instead
  of once per shell language. See generate-coreclr-helpers.md.

  Properties:
    Configuration     Release (the scripts' default), Debug or Checked. Has to match the configuration the
                      scanned assemblies were built in.
    BrowserScanPath   Overrides the browser scan path.
    WasiScanPath      Overrides the wasi scan path.
    CallHelperTargetArchitecture
                      wasm (default) or wasm64. wasm64 currently supports browser only.
    CallHelperCompilerPath
                      An explicit ordinary host crossgen2 executable or DLL. By default the
                      project uses the matching configuration's existing wasm host tool.
    CallHelperOutputRoot
                      Optional output root for verification without updating source files.
    CallHelperTargetOS
                      browser or wasi to regenerate only that flavor's tables (default: both).
                      Lets a build that produced only one flavor, such as a CI leg, regenerate
                      its own tables.
-->
<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppCurrent)</TargetFramework>
    <CallHelperTargetArchitecture Condition="'$(CallHelperTargetArchitecture)' == ''">wasm</CallHelperTargetArchitecture>
    <CallHelperTargetOS Condition="'$(CallHelperTargetArchitecture)' == 'wasm64' and '$(CallHelperTargetOS)' == ''">browser</CallHelperTargetOS>
    <CallHelperOutputRoot Condition="'$(CallHelperOutputRoot)' == ''">$(MSBuildThisFileDirectory)</CallHelperOutputRoot>
  </PropertyGroup>

  <!-- The framework P/Invoke modules, shared with the runtime tests' corerun relink so the
       checked-in tables and the ones the tests generate cannot drift apart. -->
  <Import Project="$(WasmPInvokeModulesPropsPath)" />

  <PropertyGroup>
    <_TesthostDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsBinDir)', 'testhost'))</_TesthostDir>
    <_FrameworkVersion>$(MajorVersion).$(MinorVersion).0</_FrameworkVersion>

    <!-- The scripts that drive this project are per-OS, so name the one for the current OS. -->
    <_BuildScript Condition="$([MSBuild]::IsOSPlatform('Windows'))">.\build.cmd</_BuildScript>
    <_BuildScript Condition="'$(_BuildScript)' == ''">./build.sh</_BuildScript>
  </PropertyGroup>

  <ItemGroup>
    <_WasmCallHelperTarget Include="browser" Condition="'$(CallHelperTargetOS)' == '' or '$(CallHelperTargetOS)' == 'browser'">
      <ScanPath Condition="'$(BrowserScanPath)' != ''">$([MSBuild]::EnsureTrailingSlash('$(BrowserScanPath)'))</ScanPath>
      <ScanPath Condition="'$(BrowserScanPath)' == ''">$(_TesthostDir)$(NetCoreAppCurrent)-browser-$(Configuration)-$(CallHelperTargetArchitecture)/shared/Microsoft.NETCore.App/$(_FrameworkVersion)/</ScanPath>
    </_WasmCallHelperTarget>
    <_WasmCallHelperTarget Include="wasi" Condition="'$(CallHelperTargetOS)' == '' or '$(CallHelperTargetOS)' == 'wasi'">
      <ScanPath Condition="'$(WasiScanPath)' != ''">$([MSBuild]::EnsureTrailingSlash('$(WasiScanPath)'))</ScanPath>
      <ScanPath Condition="'$(WasiScanPath)' == ''">$(_TesthostDir)$(NetCoreAppCurrent)-wasi-$(Configuration)-$(CallHelperTargetArchitecture)/shared/Microsoft.NETCore.App/$(_FrameworkVersion)/</ScanPath>
    </_WasmCallHelperTarget>
  </ItemGroup>

  <!-- The generator leaves its output unstamped: run over a user application it would be writing a
       file full of names taken from that application, which are not ours to license. The copies
       checked in here are ours, so the regeneration path stamps them on the way out of staging.
       Writing only on a real change keeps the timestamp the generator's own WriteIfDifferent was
       protecting, so regenerating an unchanged table does not retrigger the native build. -->
  <UsingTask TaskName="WriteWithLicenseHeader"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <DestinationFolder ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        foreach (ITaskItem file in Files)
        {
            string text = File.ReadAllText(file.ItemSpec);
            string newLine = text.Contains("\r\n") ? "\r\n" : "\n";
            string content =
                "// Licensed to the .NET Foundation under one or more agreements." + newLine +
                "// The .NET Foundation licenses this file to you under the MIT license." + newLine +
                "//" + newLine + newLine + text;

            string destination = Path.Combine(DestinationFolder, Path.GetFileName(file.ItemSpec));
            if (File.Exists(destination) && File.ReadAllText(destination) == content)
            {
                continue;
            }

            Log.LogMessage(MessageImportance.High, "Writing {0}", destination);
            File.WriteAllText(destination, content);
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="_ValidateCallHelperTargetOS">
    <Error Condition="'$(CallHelperTargetArchitecture)' != 'wasm' and '$(CallHelperTargetArchitecture)' != 'wasm64'"
           Text="Unknown CallHelperTargetArchitecture '$(CallHelperTargetArchitecture)'. Expected wasm or wasm64." />
    <Error Condition="'$(CallHelperTargetArchitecture)' == 'wasm64' and '$(CallHelperTargetOS)' != 'browser'"
           Text="wasm64 call helpers currently support only CallHelperTargetOS=browser." />
    <Error Condition="'@(_WasmCallHelperTarget)' == ''"
           Text="Unknown CallHelperTargetOS '$(CallHelperTargetOS)'. Expected browser or wasi." />
  </Target>

  <!-- Batched over _WasmCallHelperTarget: one crossgen2 run per wasm flavor. -->
  <Target Name="GenerateCallHelpers" DependsOnTargets="_ValidateCallHelperTargetOS" Outputs="%(_WasmCallHelperTarget.Identity)">
    <PropertyGroup>
      <_TargetOS>%(_WasmCallHelperTarget.Identity)</_TargetOS>
      <_ScanPath>%(_WasmCallHelperTarget.ScanPath)</_ScanPath>
      <!-- Crossgen2 runs on the host and takes the guest architecture on its command line.
           Its existing wasm product is also used for wasm64 portable generation; this does
           not load a wasm32 JIT or generate wasm32 layouts for the wasm64 inputs. -->
      <_Crossgen2Path>$([MSBuild]::NormalizePath('$(ArtifactsBinDir)', 'coreclr', '$(_TargetOS).wasm.$(Configuration)', '$(BuildArchitecture)', 'crossgen2', 'crossgen2$(ExeSuffix)'))</_Crossgen2Path>
      <_Crossgen2Path Condition="'$(CallHelperCompilerPath)' != ''">$([MSBuild]::NormalizePath('$(RepoRoot)', '$(CallHelperCompilerPath)'))</_Crossgen2Path>
      <_Crossgen2Extension>$([System.IO.Path]::GetExtension('$(_Crossgen2Path)').ToLowerInvariant())</_Crossgen2Extension>
      <_Crossgen2Command>&quot;$(_Crossgen2Path)&quot;</_Crossgen2Command>
      <_CallHelperDotNetHost>$(DotNetTool)</_CallHelperDotNetHost>
      <_CallHelperDotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_CallHelperDotNetHost>
      <_CallHelperDotNetHostFileName>$([System.IO.Path]::GetFileName('$(_CallHelperDotNetHost)'))</_CallHelperDotNetHostFileName>
      <_CallHelperDotNetHost Condition="'$(_CallHelperDotNetHost)' != '$(_CallHelperDotNetHostFileName)'">$([MSBuild]::NormalizePath('$(RepoRoot)', '$(_CallHelperDotNetHost)'))</_CallHelperDotNetHost>
      <_Crossgen2Command Condition="'$(_Crossgen2Extension)' == '.dll'">&quot;$(_CallHelperDotNetHost)&quot; &quot;$(_Crossgen2Path)&quot;</_Crossgen2Command>
      <_OutputDir>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', '$(CallHelperOutputRoot)', '$(_TargetOS)'))</_OutputDir>
      <_ResponseFileDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsObjDir)', 'wasm-callhelpers', '$(_TargetOS)'))</_ResponseFileDir>
      <_OutputDir Condition="'$(CallHelperTargetArchitecture)' == 'wasm64'">$(_OutputDir)wasm64/</_OutputDir>
      <_ResponseFileDir Condition="'$(CallHelperTargetArchitecture)' == 'wasm64'">$([MSBuild]::NormalizeDirectory('$(_ResponseFileDir)', 'wasm64'))</_ResponseFileDir>
      <_ResponseFile>$(_ResponseFileDir)generate-coreclr-helpers.rsp</_ResponseFile>
      <_StagingDir>$(_ResponseFileDir)generated/</_StagingDir>
    </PropertyGroup>

    <Error Condition="'$(CallHelperCompilerPath)' != '' and !Exists('$(_Crossgen2Path)')"
           Text="CallHelperCompilerPath does not exist: $(_Crossgen2Path). Supply an ordinary host crossgen2 executable or DLL." />
    <Error Condition="!Exists('$(_Crossgen2Path)')"
           Text="crossgen2 was not found at $(_Crossgen2Path). Build the runtime first: $(_BuildScript) clr+libs -os $(_TargetOS) -c $(Configuration)" />
    <Error Condition="'$(_Crossgen2Extension)' == '.dll' and '$(_CallHelperDotNetHost)' == ''"
           Text="A .NET host is required to run the crossgen2 DLL. Invoke the repository's dotnet script or set DotNetTool." />
    <Error Condition="'$(_Crossgen2Extension)' == '.dll' and '$(_CallHelperDotNetHost)' != '$(_CallHelperDotNetHostFileName)' and !Exists('$(_CallHelperDotNetHost)')"
           Text="The .NET host for the crossgen2 DLL does not exist: $(_CallHelperDotNetHost). Correct DOTNET_HOST_PATH or DotNetTool." />
    <Error Condition="!Exists('$(_ScanPath)') and '$(CallHelperTargetArchitecture)' == 'wasm64'"
           Text="The wasm64 framework scan path does not exist: $(_ScanPath). Build the matching browser-wasm64 CoreLib and libs; wasm32 framework inputs will not be substituted." />
    <Error Condition="!Exists('$(_ScanPath)')"
           Text="Scan path for $(_TargetOS) does not exist: $(_ScanPath). Build the runtime first: $(_BuildScript) clr+libs -os $(_TargetOS) -c $(Configuration)" />
    <Error Condition="'@(WasmCoreClrFrameworkPInvokeModule)' == ''"
           Text="No WasmCoreClrFrameworkPInvokeModule entries were found in $(WasmPInvokeModulesPropsPath)." />

    <Message Importance="High" Text="[$(_TargetOS)] Scan path: $(_ScanPath)" />
    <Message Importance="High" Text="[$(_TargetOS)] Output path: $(_OutputDir)" />

    <RemoveDir Directories="$(_StagingDir)" />
    <MakeDir Directories="$(_OutputDir);$(_ResponseFileDir);$(_StagingDir)" />

    <ItemGroup>
      <_ScanAssembly Remove="@(_ScanAssembly)" />
      <_ScanAssembly Include="$(_ScanPath)*.dll" />
    </ItemGroup>

    <Error Condition="'@(_ScanAssembly)' == ''"
           Text="No assemblies to scan were found in $(_ScanPath)." />

    <ItemGroup>
      <_TargetPInvokeModule Remove="@(_TargetPInvokeModule)" />
      <_TargetPInvokeModule Include="@(WasmCoreClrFrameworkPInvokeModule->WithMetadataValue('Browser', 'true'))"
                            Condition="'$(_TargetOS)' == 'browser'" />
      <_TargetPInvokeModule Include="@(WasmCoreClrFrameworkPInvokeModule->WithMetadataValue('Wasi', 'true'))"
                            Condition="'$(_TargetOS)' == 'wasi'" />
      <_GeneratorArg Remove="@(_GeneratorArg)" />
      <_GeneratorArg Include="--targetos:$(_TargetOS)" />
      <_GeneratorArg Include="--targetarch:$(CallHelperTargetArchitecture)" />
      <_GeneratorArg Include="--generate-portable-callhelpers:$(_StagingDir)" />
      <_GeneratorArg Include="@(_TargetPInvokeModule->'--directpinvoke:%(Identity)')" />
      <_GeneratorArg Include="@(_ScanAssembly->'%(FullPath)')" />
    </ItemGroup>

    <WriteLinesToFile File="$(_ResponseFile)" Lines="@(_GeneratorArg)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <Exec Command="$(_Crossgen2Command) &quot;@$(_ResponseFile)&quot;"
          WorkingDirectory="$(RepoRoot)" />

    <ItemGroup>
      <_StagedCallHelper Remove="@(_StagedCallHelper)" />
      <_StagedCallHelper Include="$(_StagingDir)*.cpp" />
    </ItemGroup>

    <Error Condition="'@(_StagedCallHelper)' == ''" Text="The generator produced no files in $(_StagingDir)." />

    <WriteWithLicenseHeader Files="@(_StagedCallHelper)" DestinationFolder="$(_OutputDir)" />
  </Target>

</Project>
