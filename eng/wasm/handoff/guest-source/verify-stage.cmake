if(NOT EXISTS "${DIRECT_PE_STAGE_MANIFEST}")
    message(FATAL_ERROR "A complete source/staged DLL hash manifest is required.")
endif()
file(READ "${DIRECT_PE_STAGE_MANIFEST}" stage_manifest)
string(JSON managed_file_count LENGTH "${stage_manifest}" explicitInputs)
if(managed_file_count LESS 1)
    message(FATAL_ERROR "An empty managed closure is not a valid guest.")
endif()
math(EXPR managed_file_last "${managed_file_count} - 1")
set(expected_staged_dlls)
foreach(index RANGE 0 ${managed_file_last})
    string(JSON source_path GET "${stage_manifest}" explicitInputs ${index} path)
    string(JSON expected_hash GET "${stage_manifest}" explicitInputs ${index} sha256)
    get_filename_component(file_name "${source_path}" NAME)
    set(staged_path "${DIRECT_PE_STAGE_DIRECTORY}/${file_name}")
    if(NOT EXISTS "${source_path}" OR NOT EXISTS "${staged_path}")
        message(FATAL_ERROR "Missing source/staged PE file: ${file_name}")
    endif()
    file(SHA256 "${source_path}" source_hash)
    file(SHA256 "${staged_path}" staged_hash)
    if(NOT source_hash STREQUAL expected_hash OR NOT staged_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Source/staged PE hash mismatch: ${file_name}")
    endif()
    list(APPEND expected_staged_dlls "${staged_path}")
endforeach()
file(GLOB actual_staged_dlls "${DIRECT_PE_STAGE_DIRECTORY}/*.dll")
list(SORT expected_staged_dlls)
list(SORT actual_staged_dlls)
if(NOT "${actual_staged_dlls}" STREQUAL "${expected_staged_dlls}")
    message(FATAL_ERROR "Staged DLL inventory differs from the complete managed closure.")
endif()
message(STATUS "Verified ${managed_file_count} actual source/staged PE hashes and complete DLL inventory.")
