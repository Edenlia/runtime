From 8620eb7b55e857a5f6e430be624b5a6605e8c53e Mon Sep 17 00:00:00 2001
From: Edenlia <74775136+Edenlia@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:41:17 +0800
Subject: [PATCH] [WebAssembly] Type-check indirect-call indices using table
 address type

Use the selected function table's IS_64 flag for call_indirect and
return_call_indirect stack indices, including the default table in the
legacy immediate-zero form. Pointer width alone does not determine a
table's address type.

Assisted-by: OpenAI Codex
---
 .../AsmParser/WebAssemblyAsmTypeCheck.cpp     | 30 +++++++++++++++++--
 .../AsmParser/WebAssemblyAsmTypeCheck.h       |  2 ++
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/llvm/lib/Target/WebAssembly/AsmParser/WebAssemblyAsmTypeCheck.cpp b/llvm/lib/Target/WebAssembly/AsmParser/WebAssemblyAsmTypeCheck.cpp
index e5420fc1ef9d80..55f733c6c417cb 100644
--- a/llvm/lib/Target/WebAssembly/AsmParser/WebAssemblyAsmTypeCheck.cpp
+++ b/llvm/lib/Target/WebAssembly/AsmParser/WebAssemblyAsmTypeCheck.cpp
@@ -292,6 +292,29 @@ bool WebAssemblyAsmTypeCheck::getTable(SMLoc ErrorLoc, const MCOperand &TableOp,
   return false;
 }
 
+bool WebAssemblyAsmTypeCheck::getFunctionTableIndexType(
+    SMLoc ErrorLoc, const MCOperand &TableOp, wasm::ValType &Type) {
+  const MCSymbolWasm *Table = nullptr;
+  if (TableOp.isImm()) {
+    // Without reference-types or call-indirect-overlong, the default table is
+    // encoded as an immediate zero rather than a symbol operand.
+    assert(TableOp.getImm() == 0 && "expected the default table operand");
+    Table = static_cast<const MCSymbolWasm *>(
+        Parser.getContext().lookupSymbol("__indirect_function_table"));
+  } else {
+    const MCSymbolRefExpr *SymRef;
+    if (getSymRef(ErrorLoc, TableOp, SymRef))
+      return true;
+    Table = static_cast<const MCSymbolWasm *>(&SymRef->getSymbol());
+  }
+  if (!Table || !Table->isFunctionTable())
+    return typeError(ErrorLoc, "expected funcref table");
+  Type = Table->getTableType().Limits.Flags & wasm::WASM_LIMITS_FLAG_IS_64
+             ? wasm::ValType::I64
+             : wasm::ValType::I32;
+  return false;
+}
+
 bool WebAssemblyAsmTypeCheck::getSignature(SMLoc ErrorLoc,
                                            const MCOperand &SigOp,
                                            wasm::WasmSymbolType Type,
@@ -606,8 +629,11 @@ bool WebAssemblyAsmTypeCheck::typeCheck(SMLoc ErrorLoc, const MCInst &Inst,
   }
 
   if (Name == "call_indirect" || Name == "return_call_indirect") {
-    // Function value.
-    bool Error = popType(ErrorLoc, wasm::ValType::I32);
+    // The callee index has the address type of the selected table.
+    wasm::ValType IndexType = wasm::ValType::I32;
+    bool Error =
+        getFunctionTableIndexType(ErrorLoc, Inst.getOperand(1), IndexType);
+    Error |= popType(ErrorLoc, Error ? StackType(Any{}) : StackType(IndexType));
     Error |= checkSig(ErrorLoc, LastSig);
     if (Name == "return_call_indirect") {
       Error |= endOfFunction(ErrorLoc, false);
diff --git a/llvm/lib/Target/WebAssembly/AsmParser/WebAssemblyAsmTypeCheck.h b/llvm/lib/Target/WebAssembly/AsmParser/WebAssemblyAsmTypeCheck.h
index e6fddf98060265..182560b7175cf1 100644
--- a/llvm/lib/Target/WebAssembly/AsmParser/WebAssemblyAsmTypeCheck.h
+++ b/llvm/lib/Target/WebAssembly/AsmParser/WebAssemblyAsmTypeCheck.h
@@ -80,6 +80,8 @@ class WebAssemblyAsmTypeCheck final {
   bool getGlobal(SMLoc ErrorLoc, const MCOperand &GlobalOp,
                  wasm::ValType &Type);
   bool getTable(SMLoc ErrorLoc, const MCOperand &TableOp, wasm::ValType &Type);
+  bool getFunctionTableIndexType(SMLoc ErrorLoc, const MCOperand &TableOp,
+                                 wasm::ValType &Type);
   bool getSignature(SMLoc ErrorLoc, const MCOperand &SigOp,
                     wasm::WasmSymbolType Type, const wasm::WasmSignature *&Sig);
   bool checkTryTable(SMLoc ErrorLoc, const MCInst &Inst);
