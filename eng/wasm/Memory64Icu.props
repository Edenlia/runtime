<Project>
  <PropertyGroup>
    <Memory64IcuDir Condition="'$(Memory64IcuDir)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsBinDir)', 'icu', 'browser-wasm64', 'Release', 'native'))</Memory64IcuDir>
    <Memory64IcuWorkDir Condition="'$(Memory64IcuWorkDir)' == ''">$([MSBuild]::NormalizeDirectory('$(ArtifactsObjDir)', 'icu', 'browser-wasm64'))</Memory64IcuWorkDir>
    <Memory64IcuSourceCacheDir Condition="'$(Memory64IcuSourceCacheDir)' == ''">$([MSBuild]::NormalizeDirectory('$(WasmToolCacheDir)', 'icu', 'source'))</Memory64IcuSourceCacheDir>
    <Memory64EmscriptenCacheDir Condition="'$(Memory64EmscriptenCacheDir)' == ''">$([MSBuild]::NormalizeDirectory('$(WasmToolCacheDir)', 'emscripten-memory64', '$(EmscriptenVersion)-$(WasmToolHostRid)'))</Memory64EmscriptenCacheDir>
    <Memory64IcuBuildJobs Condition="'$(Memory64IcuBuildJobs)' == ''">2</Memory64IcuBuildJobs>
    <PythonExecutable Condition="'$(PythonExecutable)' == ''">python3</PythonExecutable>
  </PropertyGroup>
</Project>
